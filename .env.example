NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional only after an owned domain is connected to Vercel.
NEXT_PUBLIC_ROOT_DOMAIN=

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy anon JWT also works:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Site URL: https://eventloom-beta.vercel.app (or your production domain once owned)
# Auth hardening: enable Confirm email, leaked-password protection, MFA, and CAPTCHA in Supabase Auth.
# Google: enable the Google provider in Supabase Auth and register Supabase's provider callback URL in Google Cloud.
# Redirect URLs: https://eventloom-beta.vercel.app/auth/callback, /auth/reset-password
# Local Supabase Google OAuth only:
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Launch checkout uses a server-owned $20 USD price_data item; no client-supplied price is accepted.

VERCEL_API_TOKEN=vercel_xxx
VERCEL_PROJECT_ID=prj_xxx
VERCEL_TEAM_ID=team_xxx

OPENSRS_USERNAME=
OPENSRS_API_KEY=
OPENSRS_API_URL=
REGISTRANT_ENCRYPTION_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RSVP_TOKEN_SECRET=
REFERRAL_TOKEN_SECRET=
IP_HASH_SECRET=
READINESS_TOKEN=
CRON_SECRET=

PUBLIC_SIGNUP_ENABLED=false
PUBLIC_CHECKOUT_ENABLED=false
PUBLIC_RSVP_ENABLED=false
REFERRAL_GROWTH_ENABLED=false
DOMAIN_PURCHASING_ENABLED=false
MFA_ENFORCEMENT_ENABLED=true
CSP_ENFORCE_ENABLED=false

LEGAL_BUSINESS_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
LEGAL_REVIEW_APPROVED=false
ACCOUNTING_REVIEW_APPROVED=false
PENETRATION_TEST_APPROVED=false
PROVIDER_DPA_REVIEW_APPROVED=false
PRIVACY_TABLETOP_COMPLETED=false

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

AI_GATEWAY_URL=
AI_API_KEY=
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-5.5

DOMAIN_INCLUDED_PRICE_CAP_USD=15

# Agent harness (full site generation)
# Required for production agent: Supabase + OpenAI (or AI gateway)
# Optional: Vercel tokens attach custom domains after checkout
# MFA-authenticated platform admins can inspect /api/agent/status.
