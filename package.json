{
  "name": "eventloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:audit": "npm audit --audit-level=high",
    "security:sbom": "npm sbom --sbom-format cyclonedx > eventloom-sbom.cdx.json",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run security:audit"
  },
  "dependencies": {
    "@puckeditor/core": "^0.23.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.108.1",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.3"
    }
  }
}
